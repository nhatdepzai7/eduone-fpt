OPENAI_API_KEY=your_secret_key_here
# Mã kích hoạt, cách nhau bởi dấu phẩy. Mã hợp lệ được 30 lượt AI/ngày; để trống thì mọi người chỉ có 5 lượt.
EDU_LICENSE_KEYS=
# SePay: điền đúng kiểu xác thực đã chọn lúc tạo webhook. Thiếu cả hai thì /api/sepay từ chối.
# API Key → header Authorization: Apikey ...
SEPAY_WEBHOOK_KEY=
# HMAC-SHA256 → header X-SePay-Signature, ký trên {timestamp}.{raw_body}
SEPAY_WEBHOOK_SECRET=
# Sổ quỹ bền. Thiếu một cặp thì webhook không cộng lượt.
# Upstash đặt UPSTASH_REDIS_REST_*. Tích hợp Redis trên Vercel đặt KV_REST_API_*.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Mật khẩu trang /admin. Đặt trên Vercel rồi triển khai lại. Khi biến này trống, server dùng mật khẩu tạm trong mã nguồn.
ADMIN_PASSWORD=
